# Copy to ~/.config/postfiat-listings-monitor/monitor.env (chmod 600).
# The service runs: python3 $PFLM_SCRIPT --mode auto $PFLM_ARGS
# PFLM_ARGS is split on whitespace, so paths must not contain spaces.

# Before launch: build the listings branch, serve it on 127.0.0.1 for the
# length of the run, and read the listing docs from the docs worktree.
PFLM_SCRIPT=/home/USER/repos/postfiatorg-site-listings/ops/listings-monitor/run_monitor.py
PFLM_ARGS=--serve-local --site-repo /home/USER/repos/postfiatorg-site-listings --docs-repo /home/USER/repos/postfiatl1v2-listings

# After launch: check https://postfiat.org (the default --base-url), read
# the docs from postfiatl1v2 public main, and build the site checkout only
# for the TIH audit. Keep that checkout on an up-to-date main.
# PFLM_SCRIPT=/home/USER/repos/postfiatorg.github.io/ops/listings-monitor/run_monitor.py
# PFLM_ARGS=--site-repo /home/USER/repos/postfiatorg.github.io
